# Weights/checkpoints and run products
/runs/
/artifacts/
/checkpoints/
/weights/
/pretrained/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.prm
*.tflite
**/predictions*.json
**/validation_predictions*.json
**/test_predictions*.json

# Local copied archives / third-party sources (see UPSTREAM_DEPENDENCIES.md)
/legacy/
/upstream/
*.pdf
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz

# Generated audit details stay local; retain only code and literature fingerprints
/evidence/*
!/evidence/audit_keraal_data.py
!/evidence/keraal_augmentation_review_20261014.json

# Historical reports are local; retain the small navigation index
/reports/*
!/reports/HISTORY_INDEX.md

# Preserve only the anonymized split IDs required to reproduce current partitions
/manifests/*
!/manifests/historical/
/manifests/historical/*
!/manifests/historical/principal_v1/
/manifests/historical/principal_v1/*
!/manifests/historical/principal_v1/splits.json

# Machine-specific settings and environment inventories
/configs/environment.organized.json
/configs/legacy_principal_v1/environment*.lock.txt
/configs/**/local.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
.vscode/
.idea/
.codex/
.claude/
.aws/
.ssh/

# Temporary files, logs and OS metadata
*.log
*.out
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
