# Python/build/tool caches
__pycache__/
*.py[cod]
*.nbc
*.nbi
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
node_modules/

# Dataset/media: external read-only dataset is never committed
/data/
/dataset/
/datasets/
*.npy
*.npz
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.mat
*.anvil
*.bvh
